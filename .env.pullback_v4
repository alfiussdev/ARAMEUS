# ============================================================================
# PULLBACK STRATEGY V4 - FINAL PUSH TO PROFITABILITY
# ============================================================================
# V3 Result: 31.91% WR, 47 trades, Avg Win $55, Avg Loss $41 (W/L 1.35)
# Expectancy: -$10.28 (SO CLOSE! Only $10 away from breakeven)
#
# V4 Solution: COMBO FINO - Fine-tune all 3 parameters:
#   1. Tighter SL: 2.5% → 2.25% (reduce Avg Loss $41 → $37)
#   2. Higher TP: 6.25% → 7.0% (increase Avg Win $55 → $62)
#   3. Later Trailing: 1.8R → 2.0R (let winners run even more)
#
# Expected: ~45-50 trades, 31-33% WR, Win/Loss >1.7, POSITIVE expectancy +$3-8
# THIS IS IT - The final iteration to profitability! 🎯
# ============================================================================

# Leverage Settings
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management - REBALANCED (V3.5)
MAX_EQUITY_PER_TRADE=0.10  # 10% per trade (reduced from 15%)
MAX_LOSS_PER_TRADE=0.03    # 3% max loss per position
DAILY_DRAWDOWN_LIMIT=0.99  # Disabled for testing
GLOBAL_DRAWDOWN_LIMIT=0.99 # Disabled for testing
LOSS_STREAK_LIMIT=100      # Disabled for testing
COOLDOWN_HOURS=12

# Trading Parameters - FINAL TUNING (COMBO FINO)
BASE_SL_PCT=0.0225         # 2.25% stop loss (tighter - was 2.5%)
RISK_REWARD_RATIO=2.8      # 7.0% TP1 target (higher - was 6.25%)
MAX_SPREAD=0.0025

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters - BALANCED (Sweet spot between V1 and V2)
VOL_MULTIPLIER_20=3.5      # Balanced volume 3.5x (V1:2.5x, V2:4.0x, Ultra:5.5x)
VOL_MULTIPLIER_3=2.75      # Recent volume confirmation

# RSI Thresholds - PULLBACK ZONE (50-65 for LONG, 35-50 for SHORT)
RSI_LONG_THRESHOLD=50      # Enter LONG in pullback zone (NOT exhaustion >73)
RSI_LONG_MAX=65            # Don't enter if RSI > 65 (too hot)
RSI_SHORT_THRESHOLD=50     # Enter SHORT in pullback zone (NOT exhaustion <27)
RSI_SHORT_MIN=35           # Don't enter if RSI < 35 (too cold)
RSI_INVALIDATION_LONG=20   # Don't exit until RSI < 20 (not used in NONE mode)
RSI_INVALIDATION_SHORT=80  # Don't exit until RSI > 80 (not used in NONE mode)

# Invalidation Mode - NO EARLY EXITS
# NONE = No invalidation, only stops (best for 1m data with noise)
# LIGHT = Only RSI invalidation
# MODERATE = RSI + VWAP invalidation
# AGGRESSIVE = RSI + VWAP + EMA cross (too sensitive for 1m)
INVALIDATION_MODE=NONE

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Position Management - FINAL OPTIMIZATION (LET WINNERS RUN)
TP1_CLOSE_PCT=0.50         # Close 50% at TP1 (let more position run)
ENABLE_TRAILING_STOP=True
TRAILING_STOP_ACTIVATION=2.0  # Activate at 2.0R (was 1.8R - max patience)
TRAILING_STOP_DISTANCE=0.5    # Trail 0.5R behind

# ============================================================================
# EXPECTED RESULTS WITH PULLBACK STRATEGY V4 (FINAL PUSH):
# - Trades: ~45-50/month (1.6-1.8/day) - similar to V3
# - Win Rate: 31-33% (may drop slightly due to tighter SL)
# - Avg Duration: 2.5-4 hours (similar to V3)
# - Avg Loss: ~$37 (REDUCED from V3's $41 via 2.25% SL)
# - Avg Win: ~$62-68 (INCREASED from V3's $55 via 7% TP + 2.0R trailing)
# - Win/Loss Ratio: >1.7 (vs V3's 1.35)
# - Profit Factor: >1.0 (vs V3's 0.63)
# - Expectancy: POSITIVE $3-8 (vs V3's -$10.28) 🎯
#
# V4 Combo Fino (Final Tuning):
# 1. Tighter SL: 2.5% → 2.25% (reduce losses)
# 2. Higher TP: 6.25% → 7.0% (increase wins)
# 3. Later Trailing: 1.8R → 2.0R (capture larger moves)
# 4. Keep Volume: 3.5x (proven in V3)
# 5. Keep RSI: 50-65 (proven to work)
#
# Mathematical Expectancy with 32% WR:
# E = (0.32 × $62) - (0.68 × $37) = $19.84 - $25.16 = -$5.32 (still negative)
# E = (0.33 × $65) - (0.67 × $37) = $21.45 - $24.79 = -$3.34 (close!)
#
# With 32% WR and Win/Loss 1.75:
# E = (0.32 × $65) - (0.68 × $37) = $20.80 - $25.16 = -$4.36
#
# NEED: Win/Loss > 1.8 OR Win Rate > 33% for positive expectancy
