# ============================================================================
# MARKET REGIME FILTER (NEW - CORE INNOVATION)
# ============================================================================
# This filter prevents trading in ranging/low volatility markets
# Only allows new entries when market shows sufficient trend and movement
ENABLE_REGIME_FILTER=true

# ATR Ratio Filter: Measures volatility expansion
# ATR_20 / ATR_100 >= 0.8 required to enter trades
# < 0.8 = Market in consolidation/range → NO NEW ENTRIES
ATR_SHORT_PERIOD=20        # Short-term ATR (current volatility)
ATR_LONG_PERIOD=100        # Long-term ATR (baseline volatility)
ATR_RATIO_THRESHOLD=0.8    # Min ratio to allow entries (start conservative)

# ADX Filter: Measures trend strength
# ADX >= 20 required to enter trades (trending market)
# ADX < 20 = Weak/no trend → NO NEW ENTRIES
ENABLE_ADX_FILTER=true
ADX_PERIOD=14
ADX_THRESHOLD=20           # Min ADX for trending market (standard threshold)

# NOTE: These filters work TOGETHER (both must pass)
# Higher thresholds = fewer trades but higher quality
# Lower thresholds = more trades but may include some ranges
# ============================================================================

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

