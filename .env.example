# Aggressive Compound Bot v1.2 - Environment Configuration

# Hyperliquid API Configuration
HYPERLIQUID_API_KEY=your_api_key_here
HYPERLIQUID_SECRET_KEY=your_secret_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here

# Trading Configuration
TRADING_PAIRS=HYPE/USDC,ZEC/USDC
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management
MAX_EQUITY_PER_TRADE=0.20  # 20% of equity as margin per trade
MAX_LOSS_PER_TRADE=0.05    # 5% of margin max loss
DAILY_DRAWDOWN_LIMIT=0.15  # 15% daily drawdown limit
GLOBAL_DRAWDOWN_LIMIT=0.25 # 25% global drawdown limit
LOSS_STREAK_LIMIT=3        # Number of consecutive losses before cooldown
COOLDOWN_HOURS=12          # Hours to wait after loss streak

# Trading Parameters
BASE_SL_PCT=0.005          # Base stop loss percentage (0.5%)
RISK_REWARD_RATIO=2.2      # Take profit to stop loss ratio
MAX_SPREAD=0.0025          # Maximum allowed spread (0.25%)

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters
VOL_MULTIPLIER_20=1.2      # Volume must be 1.2x the 20-period average (relaxed from 1.5x)
VOL_MULTIPLIER_3=1.2       # Volume must be 1.2x the 3-period average (not used by default)

# RSI Thresholds
RSI_LONG_THRESHOLD=52
RSI_SHORT_THRESHOLD=48
RSI_INVALIDATION_LONG=45   # More room before invalidating LONG (was 50)
RSI_INVALIDATION_SHORT=55  # More room before invalidating SHORT (was 50)

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14
ATR_MEAN_PERIOD=50
VOL_MEAN_PERIOD_20=20
VOL_MEAN_PERIOD_3=3

# Execution Settings
ORDER_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Mode
DRY_RUN=true              # Set to false for live trading
TESTNET=false             # Set to true for testnet trading
