# Aggressive Compound Bot v1.2 - Environment Configuration

# Hyperliquid API Configuration
HYPERLIQUID_API_KEY=your_api_key_here
HYPERLIQUID_SECRET_KEY=your_secret_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here

# Trading Configuration
TRADING_PAIRS=HYPE/USDC,ZEC/USDC
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management
MAX_EQUITY_PER_TRADE=0.25  # 25% of equity as margin per trade (balanced risk)
MAX_LOSS_PER_TRADE=0.04    # 4% of margin max loss
DAILY_DRAWDOWN_LIMIT=0.15  # 15% daily drawdown limit (set to 0.99 for testing)
GLOBAL_DRAWDOWN_LIMIT=0.25 # 25% global drawdown limit (set to 0.99 for testing)
LOSS_STREAK_LIMIT=3        # Number of consecutive losses before cooldown (set to 100 for testing)
COOLDOWN_HOURS=12          # Hours to wait after loss streak

# Trading Parameters
BASE_SL_PCT=0.03           # Base stop loss 3.0% (wide enough for crypto volatility)
RISK_REWARD_RATIO=2.5      # Take profit to stop loss ratio (7.5% TP1 target)
MAX_SPREAD=0.0025          # Maximum allowed spread (0.25%)

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters
VOL_MULTIPLIER_20=1.8      # Volume must be 1.8x the 20-period average (selective for quality)
VOL_MULTIPLIER_3=1.5       # Volume must be 1.5x the 3-period average

# RSI Thresholds
RSI_LONG_THRESHOLD=55       # More bullish entry requirement
RSI_SHORT_THRESHOLD=45      # More bearish entry requirement
RSI_INVALIDATION_LONG=48    # Exit if RSI drops below 48 on LONG
RSI_INVALIDATION_SHORT=52   # Exit if RSI rises above 52 on SHORT

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14
ATR_MEAN_PERIOD=50
VOL_MEAN_PERIOD_20=20
VOL_MEAN_PERIOD_3=3

# Execution Settings
ORDER_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Mode
DRY_RUN=true              # Set to false for live trading
TESTNET=false             # Set to true for testnet trading
