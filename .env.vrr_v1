# ============================================================================
# VOLATILITY REJECTION REVERSAL (VRR) STRATEGY - V1
# ============================================================================
# Strategy Type: Mean Reversion / Volatility Spike Reversal
# Timeframe: 1m primary, 5m/15m confirmation
# Trading Sessions: 12:00-22:00 UTC (high volume periods)
#
# Core Concept:
#   Capture micro-reversions after extended directional moves with:
#   - High volatility spike (>1.8× ATR in 5 candles)
#   - Extreme RSI (>74 or <26)
#   - Volume exhaustion (4× average but declining)
#   - Reversal candle structure (wick ≥40% of range)
#
# Risk Profile: High frequency, quick scalps, tight stops
# Target Win Rate: 45-55%
# Target R:R: 1.8R to 3R
# ============================================================================

# Strategy Selection
STRATEGY_TYPE=VRR  # VRR or PULLBACK

# Leverage Settings (moderate for mean reversion)
DEFAULT_LEVERAGE=8
MAX_LEVERAGE=10
MIN_LEVERAGE=6

# Risk Management - CONSERVATIVE (fast scalping requires tight risk)
MAX_EQUITY_PER_TRADE=0.08   # 8% per trade (lower than pullback)
MAX_LOSS_PER_TRADE=0.02     # 2% max loss per position
DAILY_DRAWDOWN_LIMIT=0.10   # 10% daily limit
GLOBAL_DRAWDOWN_LIMIT=0.20  # 20% global limit
LOSS_STREAK_LIMIT=5         # Stop after 5 consecutive losses
COOLDOWN_HOURS=6            # 6h cooldown after streak

# Trading Parameters - VRR SPECIFIC
BASE_SL_PCT=0.015           # 1.5% stop loss (beyond the wick)
RISK_REWARD_RATIO=1.8       # TP1 at 1.8R (2.7% target)
MAX_SPREAD=0.0030           # 0.3% max spread

# ============================================================================
# VRR ENTRY CONDITIONS
# ============================================================================

# 1. Directional Movement Filter
VRR_DIRECTION_PERIOD=5           # Check last 5 candles
VRR_DIRECTION_ATR_MULT=1.8       # Movement must be ≥ 1.8× ATR(14)

# 2. RSI Extremes (Exhaustion)
RSI_LONG_THRESHOLD=26            # Enter LONG if RSI < 26 (oversold)
RSI_SHORT_THRESHOLD=74           # Enter SHORT if RSI > 74 (overbought)
RSI_EXTREME_LONG=20              # Full size if RSI < 20
RSI_EXTREME_SHORT=80             # Full size if RSI > 80
RSI_PERIOD=14

# 3. Volume Spike Filter
VRR_VOL_SPIKE_MULT=4.0           # Volume must be > 4× average
VRR_VOL_PERIOD=20                # Volume average period
VRR_VOL_CONFIRMATION_PERIOD=10   # Secondary volume check

# 4. Reversal Candle Structure
VRR_MIN_WICK_RATIO=0.40          # Wick must be ≥ 40% of total range
VRR_STRONG_WICK_RATIO=0.70       # Strong signal if wick ≥ 70%
VRR_MIN_BODY_RATIO=0.20          # Body must be ≥ 20% of range (not doji)

# 5. Volume Divergence (Exhaustion Confirmation)
VRR_ENABLE_VOL_DIVERGENCE=true   # Check if last push has declining volume
VRR_DIVERGENCE_LOOKBACK=3        # Compare last 3 candles

# ============================================================================
# MARKET REGIME FILTERS (Avoid flat/low volatility)
# ============================================================================

# Volatility Filter
VRR_ENABLE_VOL_FILTER=true
VRR_ATR_CURRENT_PERIOD=14        # Current ATR
VRR_ATR_BASELINE_PERIOD=50       # Baseline ATR
VRR_ATR_MIN_RATIO=1.2            # ATR_current must be > 1.2× ATR_baseline

# Trend/Range Filter
VRR_ENABLE_TREND_FILTER=true
VRR_EMA_FAST=20                  # Fast EMA
VRR_EMA_SLOW=50                  # Slow EMA
VRR_MIN_EMA_SEPARATION=0.003     # EMAs must be separated by > 0.3% to trade

# Time Filter (UTC)
VRR_ENABLE_TIME_FILTER=true
VRR_START_HOUR=12                # Start trading at 12:00 UTC
VRR_END_HOUR=22                  # Stop trading at 22:00 UTC

# ============================================================================
# MULTI-TIMEFRAME CONFIRMATION
# ============================================================================

VRR_ENABLE_MTF=true
VRR_CONFIRMATION_TIMEFRAME=5m    # 5m or 15m
VRR_MTF_RSI_LONG=30              # 5m RSI must be < 30 for LONG
VRR_MTF_RSI_SHORT=70             # 5m RSI must be > 70 for SHORT

# ============================================================================
# STRUCTURAL VALIDATION
# ============================================================================

VRR_ENABLE_STRUCTURE_CHECK=true
VRR_MUST_CLOSE_IN_PREV_RANGE=true    # Reversal must close in prev candle range
VRR_CHECK_LIQUIDITY_ZONE=true        # Must be near swing high/low
VRR_LIQUIDITY_LOOKBACK=20            # Look back 20 candles for swing points

# ============================================================================
# EXIT LOGIC - ADAPTIVE (Volume Exhaustion Trail)
# ============================================================================

# Take Profit Levels
TP1_CLOSE_PCT=0.50               # Close 50% at TP1 (1.8R)
TP2_RATIO=3.0                    # TP2 at 3R (if trail active)

# Trailing Stop
ENABLE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION=2.0     # Activate at 2R
TRAILING_STOP_DISTANCE=0.6       # Trail 0.6R behind

# Adaptive Exit Conditions
VRR_EXIT_ON_VOLUME_DROP=true     # Exit if volume drops below average
VRR_EXIT_ON_RSI_NEUTRAL=true     # Exit if RSI crosses 50 (momentum lost)
VRR_EXIT_ON_COUNTER_CANDLE=true  # Exit on high-volume counter candle

# ============================================================================
# DYNAMIC POSITION SIZING
# ============================================================================

VRR_ENABLE_DYNAMIC_SIZE=true

# Full size conditions (1.0x base equity)
VRR_FULL_SIZE_RSI_LONG=20        # Full size if RSI < 20
VRR_FULL_SIZE_RSI_SHORT=80       # Full size if RSI > 80
VRR_FULL_SIZE_REQUIRES_DIVERGENCE=true

# Half size conditions (0.5x base equity)
VRR_HALF_SIZE_RSI_RANGE_LOW=70   # Half size if RSI 70-75 (SHORT)
VRR_HALF_SIZE_RSI_RANGE_HIGH=75

# MTF bonus (1.2x if multi-timeframe confirms)
VRR_MTF_SIZE_MULTIPLIER=1.2

# ============================================================================
# FAIL-SAFE CONDITIONS (Cancel Entry)
# ============================================================================

VRR_MAX_CANDLES_WAIT=3           # Cancel if no fill within 3 candles
VRR_CANCEL_ON_VWAP_CROSS=true    # Cancel if price crosses VWAP opposite
VRR_CANCEL_ON_NEW_EXPANSION=true # Cancel if new 2×ATR move same direction

# ============================================================================
# INDICATOR PERIODS
# ============================================================================

SMA_SHORT_PERIOD=20
SMA_LONG_PERIOD=50
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Spread Filter
MAX_SPREAD=0.0030

# ============================================================================
# EXPECTED PERFORMANCE METRICS (VRR V1)
# ============================================================================
# Target Metrics (60-day backtest):
#   - Win Rate: 45-55%
#   - Avg Trade Duration: 15-45 minutes
#   - R-Multiple: 0.8R - 1.2R average
#   - Profit Factor: > 1.3
#   - Max Drawdown: < 8%
#   - Expectancy: +$8-15 per trade
#
# Best Conditions:
#   - High volatility sessions (London/NY overlap)
#   - Strong directional moves followed by exhaustion
#   - Clean reversal wicks with volume divergence
#
# Worst Conditions:
#   - Choppy/ranging markets
#   - Low volume sessions (Asian hours)
#   - Continuous trending without pullbacks
# ============================================================================
