# ============================================================================
# PULLBACK STRATEGY V3 - TRIPLE OPTIMIZATION
# ============================================================================
# V2 Result: 33.33% WR, 33 trades, but Avg Win $31 too low (Win/Loss 0.78)
# V3 Solution: Triple attack on all problems
#   1. More trades: VOL 4.0x → 3.5x (sweet spot between V1 and V2)
#   2. Better Avg Win: TP 5% → 6.25%, Trailing 1.2R → 1.8R (let winners run)
#   3. Keep WR high: RSI 50-65 (proven to work)
# Goal: ~45-55 trades, 32-35% WR, Win/Loss >1.5, POSITIVE expectancy
# ============================================================================

# Leverage Settings
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management - REBALANCED (V3.5)
MAX_EQUITY_PER_TRADE=0.10  # 10% per trade (reduced from 15%)
MAX_LOSS_PER_TRADE=0.03    # 3% max loss per position
DAILY_DRAWDOWN_LIMIT=0.99  # Disabled for testing
GLOBAL_DRAWDOWN_LIMIT=0.99 # Disabled for testing
LOSS_STREAK_LIMIT=100      # Disabled for testing
COOLDOWN_HOURS=12

# Trading Parameters - OPTIMIZED FOR BETTER AVG WIN
BASE_SL_PCT=0.025          # 2.5% stop loss (keep tight)
RISK_REWARD_RATIO=2.5      # 6.25% TP1 target (was 5% - let winners run more)
MAX_SPREAD=0.0025

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters - BALANCED (Sweet spot between V1 and V2)
VOL_MULTIPLIER_20=3.5      # Balanced volume 3.5x (V1:2.5x, V2:4.0x, Ultra:5.5x)
VOL_MULTIPLIER_3=2.75      # Recent volume confirmation

# RSI Thresholds - PULLBACK ZONE (50-65 for LONG, 35-50 for SHORT)
RSI_LONG_THRESHOLD=50      # Enter LONG in pullback zone (NOT exhaustion >73)
RSI_LONG_MAX=65            # Don't enter if RSI > 65 (too hot)
RSI_SHORT_THRESHOLD=50     # Enter SHORT in pullback zone (NOT exhaustion <27)
RSI_SHORT_MIN=35           # Don't enter if RSI < 35 (too cold)
RSI_INVALIDATION_LONG=20   # Don't exit until RSI < 20 (not used in NONE mode)
RSI_INVALIDATION_SHORT=80  # Don't exit until RSI > 80 (not used in NONE mode)

# Invalidation Mode - NO EARLY EXITS
# NONE = No invalidation, only stops (best for 1m data with noise)
# LIGHT = Only RSI invalidation
# MODERATE = RSI + VWAP invalidation
# AGGRESSIVE = RSI + VWAP + EMA cross (too sensitive for 1m)
INVALIDATION_MODE=NONE

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Position Management - OPTIMIZED FOR HIGHER AVG WIN
TP1_CLOSE_PCT=0.50         # Close 50% at TP1 (let more position run)
ENABLE_TRAILING_STOP=True
TRAILING_STOP_ACTIVATION=1.8  # Activate at 1.8R (let winners run more)
TRAILING_STOP_DISTANCE=0.5    # Trail 0.5R behind

# ============================================================================
# EXPECTED RESULTS WITH PULLBACK STRATEGY V3 (TRIPLE OPTIMIZATION):
# - Trades: ~45-55/month (1.6-2.0/day) - between V1's 95 and V2's 33
# - Win Rate: 32-35% (maintain pullback advantage)
# - Avg Duration: 2.5-4 hours (similar to V1/V2)
# - Avg Loss: ~$40 (same 2.5% SL)
# - Avg Win: ~$55-60 (IMPROVED from V2's $31 via higher TP + trailing)
# - Win/Loss Ratio: >1.4 (vs V2's 0.78)
# - Profit Factor: >1.2 (vs V2's 0.39)
# - Expectancy: POSITIVE $5-10 (vs V2's -$16.11)
#
# V3 Triple Optimization:
# 1. Volume: 3.5x (more trades than V2's 4.0x, fewer than V1's 2.5x)
# 2. TP Ratio: 2.5 = 6.25% target (vs V2's 5%)
# 3. Trailing: 1.8R activation (vs V2's 1.2R - let winners run)
# 4. TP1 Close: 50% (vs V2's 60% - let more position run)
# 5. RSI: Keep 50-65 (proven to work)
#
# Compared to All Previous Versions:
# Ultra V3.5:  54 trades, 25.93% WR, $31 win, $39 loss, -$17.36 expectancy
# Pullback V1: 95 trades, 31.58% WR, $42 win, $41 loss, -$14.51 expectancy
# Pullback V2: 33 trades, 33.33% WR, $31 win, $40 loss, -$16.11 expectancy
# Pullback V3: Target 45-55 trades, 33% WR, $55+ win, POSITIVE expectancy
# ============================================================================
