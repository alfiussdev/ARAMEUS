# ============================================================================
# DYNAMIC PULLBACK CONTINUATION (DPC) STRATEGY - V1
# ============================================================================
# Strategy Type: Trend Following / Pullback Continuation
# Timeframe: 1m primary, 5m confirmation
# Trading Sessions: 07:00-20:00 UTC (London/NY overlap)
#
# Core Concept:
#   Detect clean pullbacks within strong trends and catch continuation moves:
#   - Strong trend confirmed (EMA20 > EMA50 > EMA100)
#   - Fibonacci pullback 0.382-0.618 of last swing
#   - RSI correction to neutral zone (45-55)
#   - Continuation confirmation with volume
#
# Risk Profile: Medium frequency, trend following
# Target Win Rate: 55-65%
# Target R:R: 2.2R to 3R+
# ============================================================================

# Strategy Selection
STRATEGY_TYPE=DPC  # DPC, VRR, or PULLBACK

# Leverage Settings
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management - BALANCED (1% risk per trade)
MAX_EQUITY_PER_TRADE=0.15   # 15% equity as margin per trade
MAX_LOSS_PER_TRADE=0.01     # 1% risk per position (strict)
DAILY_DRAWDOWN_LIMIT=0.10   # 10% daily limit
GLOBAL_DRAWDOWN_LIMIT=0.20  # 20% global limit
LOSS_STREAK_LIMIT=5
COOLDOWN_HOURS=6

# Trading Parameters - DPC SPECIFIC
BASE_SL_PCT=0.025           # 2.5% hard stop loss
RISK_REWARD_RATIO=2.2       # TP1 at 2.2R (5.5% target)
MAX_SPREAD=0.0020           # 0.20% max spread

# ============================================================================
# DPC MARKET REGIME FILTERS
# ============================================================================

# Trend Filter: EMA Stack
DPC_ENABLE_EMA_STACK=true
DPC_EMA_FAST=20             # EMA20
DPC_EMA_MID=50              # EMA50
DPC_EMA_SLOW=100            # EMA100
# For LONG: EMA20 > EMA50 > EMA100
# For SHORT: EMA20 < EMA50 < EMA100

# Volatility Filter
DPC_ENABLE_VOL_FILTER=true
DPC_ATR_CURRENT_PERIOD=14
DPC_ATR_BASELINE_PERIOD=50
DPC_ATR_MIN_RATIO=1.1       # ATR_14 must be >= 1.1× ATR_50

# Chop Filter (avoid ranging markets)
DPC_ENABLE_CHOP_FILTER=true
DPC_CHOP_LOOKBACK=30        # Check last 30 candles
DPC_MAX_EMA20_CROSSES=2     # Max 2 crosses of EMA20 allowed

# Time Filter (London/NY overlap)
DPC_ENABLE_TIME_FILTER=true
DPC_START_HOUR=7            # 07:00 UTC
DPC_END_HOUR=20             # 20:00 UTC

# ============================================================================
# DPC PULLBACK DETECTION
# ============================================================================

# Pullback Structure
DPC_MIN_PULLBACK_CANDLES=3  # Minimum 3 consecutive counter-trend candles
DPC_SWING_LOOKBACK=20       # Look back 20 candles for swing high/low

# Fibonacci Retracement Levels
DPC_FIB_MIN=0.382           # Minimum 38.2% retracement
DPC_FIB_MAX=0.618           # Maximum 61.8% retracement

# RSI Pullback Zone
DPC_RSI_PULLBACK_MIN=45     # RSI must pull back to 45-55 zone
DPC_RSI_PULLBACK_MAX=55
RSI_PERIOD=14

# ============================================================================
# DPC ENTRY CONDITIONS
# ============================================================================

# Price Action Confirmation
DPC_MUST_CLOSE_BEYOND_EMA20=true  # Price must reclaim EMA20

# RSI Momentum Resumption
DPC_RSI_LONG_ENTRY_MIN=50   # For LONG: RSI must cross 50 → 55
DPC_RSI_LONG_ENTRY_MAX=55
DPC_RSI_SHORT_ENTRY_MIN=45  # For SHORT: RSI must cross 50 → 45
DPC_RSI_SHORT_ENTRY_MAX=50

# Volume Confirmation
DPC_VOL_SPIKE_MULT=1.8      # Volume >= 1.8× average of last 10 candles
DPC_VOL_PERIOD=10

# Candle Structure (prefer engulfing/marubozu)
DPC_MAX_WICK_RATIO=0.30     # Wick should be ≤ 30% of total range

# Multi-Timeframe Confirmation (5m)
DPC_ENABLE_MTF=true
DPC_CONFIRMATION_TIMEFRAME=5m
# For LONG: close_5m > EMA20_5m
# For SHORT: close_5m < EMA20_5m

# ============================================================================
# DPC POSITION SIZING (Dynamic based on ATR ratio)
# ============================================================================

DPC_ENABLE_DYNAMIC_SIZING=true
DPC_BASE_MARGIN_PCT=0.15    # 15% base margin

# ATR-based adjustments
DPC_HIGH_VOL_ATR_RATIO=1.5  # If ATR_ratio > 1.5 → reduce margin to 10%
DPC_HIGH_VOL_MARGIN_PCT=0.10
DPC_LOW_VOL_ATR_RATIO=1.0   # If ATR_ratio < 1.0 → increase margin to 20%
DPC_LOW_VOL_MARGIN_PCT=0.20

# ============================================================================
# DPC EXIT LOGIC
# ============================================================================

# Stop Loss
DPC_SL_TYPE=swing           # "swing" or "fixed"
DPC_SWING_SL_BUFFER=0.002   # 0.2% buffer beyond swing point
DPC_FIXED_SL_PCT=0.025      # 2.5% hard stop if swing not available

# ATR-based SL adjustment
DPC_ADJUST_SL_BY_ATR=true
DPC_HIGH_VOL_SL_MULT=1.3    # If ATR_ratio > 1.5 → widen SL by 1.3×
DPC_LOW_VOL_SL_MULT=0.8     # If ATR_ratio < 1.0 → tighten SL by 0.8×

# Take Profit
TP1_CLOSE_PCT=0.50          # Close 50% at TP1 (2.2R)
TP2_RATIO=3.0               # TP2 at 3R

# Trailing Stop
ENABLE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION=3.0  # Activate trailing at 3R
TRAILING_STOP_DISTANCE=1.0    # Trail 1R behind

# Breakeven Move (when RSI extreme)
DPC_ENABLE_BREAKEVEN_MOVE=true
DPC_BE_RSI_LONG=70          # If RSI > 70 (LONG) → move trail to BE + 0.5R
DPC_BE_RSI_SHORT=30         # If RSI < 30 (SHORT) → move trail to BE + 0.5R
DPC_BE_BUFFER=0.005         # Breakeven + 0.5% buffer

# ============================================================================
# DPC MOMENTUM EXIT (Early Exit Conditions)
# ============================================================================

# RSI Reversal Exit
DPC_EXIT_ON_RSI_REVERSAL=true
# For LONG: Exit if RSI crosses back below 50
# For SHORT: Exit if RSI crosses back above 50

# Volume Fade Exit
DPC_EXIT_ON_VOL_FADE=true
DPC_VOL_FADE_CANDLES=2      # 2 consecutive candles
DPC_VOL_FADE_RATIO=0.60     # Each candle range < 60% of previous

# EMA Cross Exit (Structure Break)
DPC_EXIT_ON_EMA_CROSS=true
# For LONG: Exit if price < EMA20 AND EMA9 < EMA20
# For SHORT: Exit if price > EMA20 AND EMA9 > EMA20

# ============================================================================
# INDICATOR PERIODS
# ============================================================================

SMA_SHORT_PERIOD=20
SMA_LONG_PERIOD=50
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0

# ============================================================================
# EXPECTED PERFORMANCE METRICS (DPC V1)
# ============================================================================
# Target Metrics (60-day backtest):
#   - Win Rate: 55-65%
#   - Avg Trade Duration: 1-4 hours
#   - R-Multiple: 1.2R - 2.0R average
#   - Profit Factor: > 1.8
#   - Max Drawdown: < 10%
#   - Expectancy: +$15-30 per trade
#
# Best Conditions:
#   - Strong trending markets (crypto bull/bear runs)
#   - Clean EMA stack alignment
#   - London/NY sessions with volume
#
# Worst Conditions:
#   - Choppy ranging markets (filtered by chop detection)
#   - Low volume Asian hours (filtered by time)
#   - Fake breakouts (filtered by Fibonacci + volume)
# ============================================================================
