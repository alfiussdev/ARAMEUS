# ============================================================================
# PULLBACK STRATEGY V1 - BUY THE DIP IN UPTRENDS
# ============================================================================
# Problem: Ultra_selective catches parabolic tops (RSI>73, 5.5x volume)
# Solution: Enter on pullbacks in confirmed uptrends (RSI 50-65 zone)
# Goal: Improve win rate from 25% to 40%+ by avoiding exhaustion moves
# ============================================================================

# Leverage Settings
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management - REBALANCED (V3.5)
MAX_EQUITY_PER_TRADE=0.10  # 10% per trade (reduced from 15%)
MAX_LOSS_PER_TRADE=0.03    # 3% max loss per position
DAILY_DRAWDOWN_LIMIT=0.99  # Disabled for testing
GLOBAL_DRAWDOWN_LIMIT=0.99 # Disabled for testing
LOSS_STREAK_LIMIT=100      # Disabled for testing
COOLDOWN_HOURS=12

# Trading Parameters - TIGHTER STOPS, CLOSER TPS
BASE_SL_PCT=0.025          # 2.5% stop loss (tighter - was 5%)
RISK_REWARD_RATIO=2.0      # 5% TP1 target (more achievable - was 15%)
MAX_SPREAD=0.0025

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters - PULLBACK (Moderate volume, not spikes)
VOL_MULTIPLIER_20=2.5      # Moderate volume 2.5x (NOT parabolic 5.5x spikes)
VOL_MULTIPLIER_3=2.0       # Recent volume confirmation

# RSI Thresholds - PULLBACK ZONE (50-65 for LONG, 35-50 for SHORT)
RSI_LONG_THRESHOLD=50      # Enter LONG in pullback zone (NOT exhaustion >73)
RSI_LONG_MAX=65            # Don't enter if RSI > 65 (too hot)
RSI_SHORT_THRESHOLD=50     # Enter SHORT in pullback zone (NOT exhaustion <27)
RSI_SHORT_MIN=35           # Don't enter if RSI < 35 (too cold)
RSI_INVALIDATION_LONG=20   # Don't exit until RSI < 20 (not used in NONE mode)
RSI_INVALIDATION_SHORT=80  # Don't exit until RSI > 80 (not used in NONE mode)

# Invalidation Mode - NO EARLY EXITS
# NONE = No invalidation, only stops (best for 1m data with noise)
# LIGHT = Only RSI invalidation
# MODERATE = RSI + VWAP invalidation
# AGGRESSIVE = RSI + VWAP + EMA cross (too sensitive for 1m)
INVALIDATION_MODE=NONE

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Position Management - OPTIMIZED FOR WIN RATE
TP1_CLOSE_PCT=0.60         # Close 60% at TP1 (lock profits faster)
ENABLE_TRAILING_STOP=True
TRAILING_STOP_ACTIVATION=1.2  # Activate at 1.2R (earlier protection)
TRAILING_STOP_DISTANCE=0.5    # Trail 0.5R behind

# ============================================================================
# EXPECTED RESULTS WITH PULLBACK STRATEGY V1:
# - Trades: ~40-60/month (1.5-2/day) - similar frequency
# - Win Rate: 40-50% instead of 25% (entering pullbacks, not tops)
# - Avg Duration: 3-6 hours (longer holds in trend continuation)
# - Avg Loss: ~$26 (same 2.5% SL)
# - Avg Win: ~$52 (same 5% TP)
# - Profit Factor: >1.5 instead of 0.39 (much better)
# - Expectancy: POSITIVE $8-15 instead of -$17.36
#
# Strategy Logic:
# - Wait for RSI to cool from overbought (50-65 zone)
# - Volume moderate but present (2.5x, not 5.5x spikes)
# - Still require trend (SMA50>200) + momentum (EMA9>20) + VWAP support
# ============================================================================
