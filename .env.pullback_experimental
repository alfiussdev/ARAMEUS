# RSI Thresholds - EXPERIMENTAL (Wider and lower range)
RSI_LONG_THRESHOLD=42      # Enter LONG earlier (partner proposal: 42-62 zone)
RSI_LONG_MAX=62            # Don't enter if RSI > 62 (was 65)
RSI_SHORT_THRESHOLD=50     # Enter SHORT in pullback zone (NOT exhaustion <27)
RSI_SHORT_MIN=38           # Don't enter if RSI < 38 (symmetric to LONG range)
RSI_INVALIDATION_LONG=20   # Don't exit until RSI < 20 (not used in NONE mode)
RSI_INVALIDATION_SHORT=80  # Don't exit until RSI > 80 (not used in NONE mode)

# Invalidation Mode - NO EARLY EXITS
# NONE = No invalidation, only stops (best for 1m data with noise)
# LIGHT = Only RSI invalidation
# MODERATE = RSI + VWAP invalidation
# AGGRESSIVE = RSI + VWAP + EMA cross (too sensitive for 1m)
INVALIDATION_MODE=NONE

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Position Management - EXPERIMENTAL (More patient trailing)
TP1_CLOSE_PCT=0.50         # Close 50% at TP1 (let more position run)
ENABLE_TRAILING_STOP=True
TRAILING_STOP_ACTIVATION=2.0  # Activate at 2.0R (keep from V4)
TRAILING_STOP_DISTANCE=0.75   # Trail 0.75R behind (partner proposal - more room)

