MAX_SPREAD=0.0025

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters - EXPERIMENTAL (More permissive)
VOL_MULTIPLIER_20=2.5      # Lower threshold 2.5x (partner proposal - more trades)
