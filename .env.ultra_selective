# ============================================================================
# ULTRA SELECTIVE CONFIGURATION - FOR QUALITY OVER QUANTITY
# ============================================================================
# Based on backtest results showing massive over-trading (15 trades/day)
# Goal: Reduce to 1 trade/day (~30 trades/month) with 35%+ win rate
# ============================================================================

# Leverage Settings
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=12
MIN_LEVERAGE=8

# Risk Management - VERY CONSERVATIVE
MAX_EQUITY_PER_TRADE=0.15  # Only 15% per trade (was 25% - too aggressive)
MAX_LOSS_PER_TRADE=0.03    # 3% max loss per position
DAILY_DRAWDOWN_LIMIT=0.99  # Disabled for testing
GLOBAL_DRAWDOWN_LIMIT=0.99 # Disabled for testing
LOSS_STREAK_LIMIT=100      # Disabled for testing
COOLDOWN_HOURS=12

# Trading Parameters - WIDER STOPS
BASE_SL_PCT=0.05           # 5% stop loss (was 3% - too tight)
RISK_REWARD_RATIO=3.0      # 15% TP1 target (5% SL × 3R)
MAX_SPREAD=0.0025

# Volatility Thresholds
VOL_RATIO_MIN=0.6
VOL_RATIO_MAX=3.0
VOL_RATIO_HIGH_THRESHOLD=1.5
VOL_RATIO_LOW_THRESHOLD=0.9

# Volume Filters - NUCLEAR STRICT (ONLY THE ABSOLUTE BIGGEST MOVES)
VOL_MULTIPLIER_20=7.0      # Volume must be 7x average (only extreme breakouts)
VOL_MULTIPLIER_3=5.0       # Recent volume must be 5x

# RSI Thresholds - NUCLEAR MOMENTUM REQUIRED
RSI_LONG_THRESHOLD=78      # Only enter LONG with RSI > 78 (parabolic moves only)
RSI_SHORT_THRESHOLD=22     # Only enter SHORT with RSI < 22 (parabolic moves only)
RSI_INVALIDATION_LONG=20   # Don't exit until RSI < 20 (not used in NONE mode)
RSI_INVALIDATION_SHORT=80  # Don't exit until RSI > 80 (not used in NONE mode)

# Invalidation Mode - NO EARLY EXITS
# NONE = No invalidation, only stops (best for 1m data with noise)
# LIGHT = Only RSI invalidation
# MODERATE = RSI + VWAP invalidation
# AGGRESSIVE = RSI + VWAP + EMA cross (too sensitive for 1m)
INVALIDATION_MODE=NONE

# Indicator Periods
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
RSI_PERIOD=14
ATR_PERIOD=14

# Timeframes
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# Position Management
TP1_CLOSE_PCT=0.50         # Close 50% at TP1
ENABLE_TRAILING_STOP=True
TRAILING_STOP_ACTIVATION=1.5  # Activate at 1.5R
TRAILING_STOP_DISTANCE=0.5    # Trail 0.5R behind

# ============================================================================
# EXPECTED RESULTS WITH THIS CONFIG:
# - Trades: ~30/month (1/day) instead of 450/month (15/day)
# - Win Rate: 35-45% instead of 15-24%
# - Avg Duration: 2-4 hours instead of 18-24 minutes
# - Profit Factor: >1.5 instead of 0.32-0.52
# ============================================================================
