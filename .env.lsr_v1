# ============================================================================
# AGGRESSIVE COMPOUND BOT — LSR v1 Configuration
# ============================================================================
# Strategy: Liquidity Sweep + Reaction Engine (LSR)
# Concept: Detect false breakouts (liquidity sweeps) + RSI divergence + quick reversal
# Ideal for: Range-bound or transitional markets
# ============================================================================

# ----------------------------------------------------------------------------
# STRATEGY SELECTION
# ----------------------------------------------------------------------------
STRATEGY_TYPE=LSR

# ----------------------------------------------------------------------------
# EXCHANGE & PAIR CONFIGURATION
# ----------------------------------------------------------------------------
EXCHANGE=binance
TRADING_PAIR=SOL/USDC
PRIMARY_TIMEFRAME=1m
CONFIRMATION_TIMEFRAME=5m

# ----------------------------------------------------------------------------
# RISK MANAGEMENT (Conservative for sweep reversals)
# ----------------------------------------------------------------------------
INITIAL_EQUITY=10000
MAX_LOSS_PER_TRADE=0.012          # 1.2% risk per trade (tight control)
BASE_SL_PCT=0.025                 # 2.5% fallback stop loss
RISK_REWARD_RATIO=2.5             # TP1 at 2.5R (50% close)
MAX_LEVERAGE=12                   # Maximum 12x leverage
ENABLE_DYNAMIC_LEVERAGE=true
MIN_LEVERAGE=8                    # Minimum 8x (range: 8-12x)

# ----------------------------------------------------------------------------
# POSITION SIZING & MARGIN CONTROL
# ----------------------------------------------------------------------------
BASE_POSITION_SIZE_PCT=0.15       # 15% of equity (adjusted by volatility)
MARGIN_USAGE_TARGET=0.15          # 15% margin usage baseline
ENABLE_ADAPTIVE_SIZING=true       # Adjust size by volatility + sweep distance

# Volatility-based adjustments
HIGH_VOL_THRESHOLD=1.3            # If ATR_ratio > 1.3 → reduce size
LOW_VOL_THRESHOLD=1.0             # If ATR_ratio < 1.0 → increase size
HIGH_VOL_SIZE_MULT=0.67           # 10% equity in high vol
LOW_VOL_SIZE_MULT=1.33            # 20% equity in low vol

# ----------------------------------------------------------------------------
# LSR — MARKET REGIME FILTERS
# ----------------------------------------------------------------------------
LSR_ATR_MIN_RATIO=1.0             # Require moderate-high volatility (ATR_14 ≥ 1.0× ATR_50)
LSR_MAX_SPREAD_PCT=0.0025         # Max spread 0.25%
LSR_START_HOUR=7                  # London open (07:00 UTC)
LSR_END_HOUR=20                   # NY close (20:00 UTC)

# ----------------------------------------------------------------------------
# LSR — STRUCTURE DETECTION (Swing Levels)
# ----------------------------------------------------------------------------
LSR_MIN_TOUCHES=3                 # Require at least 3 touches to validate support/resistance
LSR_TOUCH_TOLERANCE=0.008         # 0.8% tolerance for "touching" a level
LSR_STRUCTURE_LOOKBACK=60         # Use last 60 candles for structure detection (1 hour on 1m)

# ----------------------------------------------------------------------------
# LSR — LIQUIDITY SWEEP DETECTION
# ----------------------------------------------------------------------------
LSR_SWEEP_VOLUME_MULT=2.5         # Volume must be ≥2.5× average (20 candles)
LSR_SWEEP_MIN_WICK=0.50           # Wick must be ≥50% of total candle range
# Sweep validation: price breaks level + volume spike + large wick + closes back inside

# ----------------------------------------------------------------------------
# LSR — RSI DIVERGENCE DETECTION
# ----------------------------------------------------------------------------
RSI_PERIOD=14                     # Standard RSI period
LSR_RSI_LOOKBACK=10               # Look back 10 candles for divergence
# Bullish divergence: price lower low, RSI higher low
# Bearish divergence: price higher high, RSI lower high

# ----------------------------------------------------------------------------
# LSR — CONFIRMATION CANDLE
# ----------------------------------------------------------------------------
LSR_CONFIRM_VOLUME_MULT=1.2       # Confirmation candle needs ≥1.2× avg volume
LSR_CONFIRM_MAX_SPREAD=0.002      # Max spread 0.2% for confirmation
LSR_CONFIRM_TIMEOUT=3             # Cancel if no confirmation within 3 candles

# ----------------------------------------------------------------------------
# LSR — ENTRY LOGIC
# ----------------------------------------------------------------------------
# LONG Entry (Bullish Sweep):
#   1. Detect support with ≥3 touches
#   2. Price sweeps below support (volume spike, wick ≥50%, closes above)
#   3. RSI bullish divergence (price lower low, RSI higher low)
#   4. Next candle closes above support with volume ≥1.2× avg
#
# SHORT Entry (Bearish Sweep):
#   1. Detect resistance with ≥3 touches
#   2. Price sweeps above resistance (volume spike, wick ≥50%, closes below)
#   3. RSI bearish divergence (price higher high, RSI lower high)
#   4. Next candle closes below resistance with volume ≥1.2× avg

# ----------------------------------------------------------------------------
# LSR — EXIT LOGIC (Stop Loss)
# ----------------------------------------------------------------------------
LSR_MAX_SL_PCT=0.006              # Maximum stop loss: 0.6% of notional
# SL placement: just beyond sweep wick
#   LONG: below sweep low
#   SHORT: above sweep high
# If high volatility (ATR_ratio > 1.5) → widen SL by 25% and reduce size

LSR_SL_VOLATILITY_MULT=1.25       # Widen SL by 25% if ATR_ratio > 1.5
LSR_HIGH_VOL_ATR_THRESHOLD=1.5    # ATR ratio threshold for SL widening

# ----------------------------------------------------------------------------
# LSR — EXIT LOGIC (Take Profit)
# ----------------------------------------------------------------------------
LSR_TP1_RR=2.5                    # TP1 at 2.5R (close 50% position)
LSR_TP2_RR=4.0                    # TP2 at 4R (close remaining 50%)
LSR_TP1_CLOSE_PCT=0.50            # Close 50% at TP1

# Trailing stop (optional)
ENABLE_TRAILING_STOP=true
LSR_TRAILING_ACTIVATION_RR=2.5    # Activate trailing at 2.5R
LSR_TRAILING_DISTANCE_RR=0.8      # Trail distance: 0.8R

# ----------------------------------------------------------------------------
# LSR — INVALIDATION EXIT
# ----------------------------------------------------------------------------
LSR_INVALIDATION_CANDLES=2        # Exit if price closes inside sweep zone for 2 consecutive candles
LSR_VOLUME_FADE_MULT=0.5          # Exit if volume drops below 0.5× average (momentum lost)

# RSI-based invalidation
LSR_EXIT_ON_RSI_EXTREME=true      # Exit if RSI enters opposite extreme
LSR_RSI_LONG_EXIT=70              # Exit LONG if RSI > 70 (overbought)
LSR_RSI_SHORT_EXIT=30             # Exit SHORT if RSI < 30 (oversold)

# ----------------------------------------------------------------------------
# INDICATOR PERIODS (Shared)
# ----------------------------------------------------------------------------
SMA_SHORT_PERIOD=50
SMA_LONG_PERIOD=200
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=20
ATR_PERIOD=14
ATR_MEAN_PERIOD=50
VOL_MEAN_PERIOD_20=20
VOL_MEAN_PERIOD_3=3

# ----------------------------------------------------------------------------
# OPERATIONAL CONTROLS
# ----------------------------------------------------------------------------
ENABLE_TRADING=true
ENABLE_PULLBACK_INVALIDATION=false   # LSR uses custom invalidation logic
MAX_OPEN_POSITIONS=1
ENABLE_COMPOUND_MODE=true
COMPOUND_REINVEST_PCT=1.0

# Multi-Timeframe Confirmation (5m for structure validation)
ENABLE_MTF_CONFIRMATION=true
MTF_MIN_AGREEMENT=1                  # Require 5m agreement on structure

# ----------------------------------------------------------------------------
# LOGGING & MONITORING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_SIGNAL_DEBUG=false
SAVE_EQUITY_CURVE=true

# ----------------------------------------------------------------------------
# BACKTESTING SPECIFIC
# ----------------------------------------------------------------------------
BACKTEST_INITIAL_EQUITY=10000
BACKTEST_DAYS=60
BACKTEST_ENABLE_DEBUG=false

# ============================================================================
# LSR STRATEGY SUMMARY
# ============================================================================
# Entry:
#   - Detect swing levels with ≥3 touches
#   - Liquidity sweep: price breaks level + volume ≥2.5× + wick ≥50% + closes inside
#   - RSI divergence (price new high/low, RSI doesn't follow)
#   - Confirmation candle closes opposite to sweep with volume ≥1.2×
#
# Exit:
#   - SL: Beyond sweep wick (max 0.6%)
#   - TP1: 2.5R (50%), TP2: 4R (50%)
#   - Trailing: Activate at 2.5R, trail 0.8R
#   - Invalidation: Price re-enters sweep zone for 2 candles, or volume fade
#
# Target: 55-65% WR, 2.5R-4R, +$20-40 expectancy
# ============================================================================
